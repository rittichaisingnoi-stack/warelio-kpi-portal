# ==============================================================================
# 1. สำหรับเครื่องเซิร์ฟเวอร์ในบริษัท (On-Premise: 10.5.3.242)
# ==============================================================================
PORT=8882
DB_HOST=10.5.3.242
DB_PORT=5432
DB_NAME=LogiTrackDB
DB_USER=postgres
DB_PASSWORD=103136

# ตั้งค่าเชื่อมต่อไปยัง Supabase เพื่อทำ 2-Way Sync อัตโนมัติ (หรือตั้งค่าผ่านปุ่ม "ตั้งค่า Cloud" บนหน้าเว็บก็ได้)
SUPABASE_DB_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
RENDER_APP_URL=https://warelio-kpi-portal.onrender.com
AUTO_SYNC_ENABLED=true
SYNC_INTERVAL_MINUTES=5

# ==============================================================================
# 2. สำหรับตั้งค่า Environment Variables บน Render.com (Cloud 4G/5G)
# ==============================================================================
# บน Render ให้ใส่เฉพาะค่า DATABASE_URL ชี้ไปที่ Supabase ของคุณ:
# DATABASE_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# IS_CLOUD=true

